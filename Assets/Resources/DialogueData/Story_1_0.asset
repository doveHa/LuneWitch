  m_Script: {fileID: 11500000, guid: 6d9aab5c9c9d22b43bf5c4fdd35c67ef, type: 3}
  m_Name: Story_1_0
  m_EditorClassIdentifier: 
  introTitle: "\uC81C 1\uC7A5"
  introDescription: "\uB9C8\uB140\uC758 \uC232"
  bgm: {fileID: 8300000, guid: 45c9c182d32a5ef4aaaceb6503d34e49, type: 3}
  backgroundSprite: {fileID: -2007323066047294462, guid: 33b027faad2ce7a4799c9ef72ab087c6, type: 3}
  isIllustrationMode: 0
  illustrationSprite: {fileID: 0}
  tsvFile: {fileID: 4900000, guid: 5c7d661b2219cb24fb815bb527d0dbe5, type: 3}
  lines:
  - speakerType: 0
    speakerName: 
    text: "\uC2E0\uBE44\uD55C \uC0DD\uBB3C\uC774 \uC790\uB77C\uB098\uB294 \uB9C8\uBC95\uC758
      \uC232 \uAC00\uC6B4\uB370 \uB178\uB780\uC0C9 \uB9AC\uBCF8\uC744 \uB2E8 \uAC08\uC0C9\uBA38\uB9AC
      \uC18C\uB140\uAC00 \uB9C8\uBC95 \uC7AC\uB8CC\uB97C \uAD6C\uD558\uACE0 \uC788\uB2E4."
    leftSprite: {fileID: 0}
    rightSprite: {fileID: 0}
    eventCommand: 
  - speakerType: 1
    speakerName: ???
    text: "\uD5E4\uD5E4, \uC624\uB298 \uC6B4\uC774 \uC815\uB9D0 \uC88B\uB124!"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 0}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uBA70\uCE60 \uC9F8 \uCC3E\uC544\uB2E4\uB140\uB3C4 \uC548 \uBCF4\uC600\uB358
      \uC7AC\uB8CC\uB97C \uB4DC\uB514\uC5B4 \uC190\uC5D0 \uB123\uB2E4\uB2C8!!"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 0}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uC774\uC81C \uC2A4\uC2B9\uB2D8\uAED8 \uC7AC\uB8CC\uB97C \uAC00\uC838\uB2E4
      \uB4DC\uB9B4 \uC218 \uC788\uACA0\uC5B4~!"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 0}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uC544! \uB0A8\uC740 \uC7AC\uB8CC\uB4E4\uC740\_ \uACFC\uC790\uC5D0 \uB123\uC5B4\uC11C
      \uB9CC\uB4E4\uC5B4 \uBD10\uC57C\uC9C0!"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 0}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uD6C4\uD6C4.. \uB9C8\uB825 \uD68C\uBCF5\uB3C4 \uAC00\uB2A5\uD55C \uD68D\uAE30\uC801\uC778
      \uACFC\uC790\uB77C\uB2C8!"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 0}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uB9DB\uC774 \uAD1C\uCC2E\uC73C\uBA74 \uC6B0\uB9AC \uAC00\uAC8C\uC5D0\uB3C4
      \uD314\uC544\uBD10\uC57C\uC9C0~"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 0}
    eventCommand: 
  - speakerType: 0
    speakerName: 
    text: "\uC232\uAE38 \uC800\uD3B8, \uC9C0\uCCD0 \uBCF4\uC774\uB294 \uC0AC\uB78C\uC758
      \uBAA8\uC2B5\uC774 \uC5B4\uB834\uD48B\uC774 \uB208\uC5D0 \uB4E4\uC5B4\uC628\uB2E4."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 0}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uC751\u2026? \uB204\uAD6C\uC9C0? \uAE38\uC744 \uC798\uBABB \uB4E0 \uC778\uAC04\uC778\uAC00?"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 0}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uC0C1\uD0DC\uAC00 \uC870\uAE08 \uC548 \uC88B\uC544 \uBCF4\uC774\uB294\uB370.."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 0}
    eventCommand: 
  - speakerType: 0
    speakerName: 
    text: "\uB8E8\uBBF8\uB098\uAC00 \uB2E4\uAC00\uC11C\uC790, \uC5B4\uB518\uAC00
      \uC544\uD30C \uBCF4\uC774\uB294 \uBCA8\uBAA8\uB9AC\uC544\uC601\uC9C0 \uC2DC\uBBFC\uC758
      \uBAA8\uC2B5\uC774 \uB208\uC5D0 \uB4E4\uC5B4\uC654\uB2E4."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 0}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uC548\uB155\uD558\uC138\uC694! \uD639\uC2DC \uB3C4\uC6C0\uC774 \uD544\uC694\uD558\uC2E0\uAC00\uC694?"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 0}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC2DC\uBBFC"
    text: ....
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -9194723345426570509, guid: 228b3c56279d772459dcc2527efd5edf, type: 3}
    eventCommand: 
  - speakerType: 0
    speakerName: 
    text: "\uB8E8\uBBF8\uB098\uAC00 \uC870\uC2EC\uC2A4\uB808 \uB9D0\uC744 \uAC78\uC5C8\uC9C0\uB9CC,
      \\n\uBCA8\uBAA8\uB9AC\uC544\uC601\uC9C0\uC758 \uC2DC\uBBFC\uC740 \uC544\uBB34\uB7F0
      \uB300\uB2F5\uC774 \uC5C6\uC5C8\uB2E4."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -9194723345426570509, guid: 228b3c56279d772459dcc2527efd5edf, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "( \uBB54\uAC00 \uC774\uC0C1\uD55C \uAC83 \uAC19\uC544\u2026 \uC774\uB807\uAC8C
      \uAC00\uAE4C\uC774\uC11C \uBB3C\uC5C8\uB294\uB370\uB3C4 \uB300\uB2F5\uC774
      \uC5C6\uC5B4. )"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -9194723345426570509, guid: 228b3c56279d772459dcc2527efd5edf, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "( \uD639\uC2DC \uB300\uB2F5\uC744 \uBABB \uD560 \uC815\uB3C4\uB85C \uC544\uD508\uAC78\uAE4C?
      )"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -9194723345426570509, guid: 228b3c56279d772459dcc2527efd5edf, type: 3}
    eventCommand: 
  - speakerType: 0
    speakerName: 
    text: "\uADF8\uB7EC\uC790 \uC0C1\uB300\uAC00 \uAC11\uC790\uAE30 \uACF5\uACA9\uD574
      \uC628\uB2E4."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -9194723345426570509, guid: 228b3c56279d772459dcc2527efd5edf, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC2DC\uBBFC"
    text: "\uD06C\uC544\uC545..!!"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -9194723345426570509, guid: 228b3c56279d772459dcc2527efd5edf, type: 3}
    eventCommand: SFX:1
  - speakerType: 0
    speakerName: 
    text: "\uB8E8\uBBF8\uB098\uB294 \uAC11\uC790\uAE30 \uC77C\uC5B4\uB09C \uC0C1\uD669\uC5D0
      \uB2F9\uD669\uD558\uC600\uC9C0\uB9CC \uBA87 \uBC88 \uB354 \uB9D0\uC744 \uAC78\uC5B4\uBCF8\uB2E4."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -9194723345426570509, guid: 228b3c56279d772459dcc2527efd5edf, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uC557, \uC704\uD5D8\uD558\uC796\uC544\uC694!"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -9194723345426570509, guid: 228b3c56279d772459dcc2527efd5edf, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uC774\uBD10\uC694! \uC815\uC2E0 \uC880 \uCC28\uB824\uBCF4\uC138\uC694!!"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -9194723345426570509, guid: 228b3c56279d772459dcc2527efd5edf, type: 3}
    eventCommand: 
  - speakerType: 0
    speakerName: 
    text: "\uADF8\uB7EC\uB098 \uC0C1\uB300\uB294 \uB8E8\uBBF8\uB098\uC758 \uB9D0\uC744
      \uB4E4\uC744 \uC0DD\uAC01\uC774 \uC5C6\uB294 \uAC83\uCC98\uB7FC \uACC4\uC18D\uD574\uC11C
      \uACF5\uACA9\uC744 \uC2DC\uB3C4\uD588\uACE0, \\n\uACB0\uAD6D \uB8E8\uBBF8\uB098\uB3C4 
      \uB9C8\uB825\uC744 \uC0AC\uC6A9\uD558\uAE30\uB85C \uACB0\uC815\uD55C\uB2E4."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -9194723345426570509, guid: 228b3c56279d772459dcc2527efd5edf, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uC5B4\uCA54 \uC218 \uC5C6\uB124\u2026! \uC704\uD5D8\uD558\uB2C8\uAE4C
      \uB9C8\uB825\uC744 \uC0AC\uC6A9\uD558\uC790!"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -9194723345426570509, guid: 228b3c56279d772459dcc2527efd5edf, type: 3}
    eventCommand: 
