  m_Name: Story_1_1
  m_EditorClassIdentifier: 
  introTitle: "\uC81C 1\uC7A5"
  introDescription: "\uC804\uD22C \uD6C4"
  backgroundSprite: {fileID: -2007323066047294462, guid: 33b027faad2ce7a4799c9ef72ab087c6, type: 3}
  isIllustrationMode: 0
  illustrationSprite: {fileID: 0}
  tsvFile: {fileID: 4900000, guid: fe63dec2fafca204db393818401eb455, type: 3}
  lines:
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uD5C9! \uC124\uB9C8\u2026 \uC8FD\uC740 \uAC74 \uC544\uB2C8\uACA0\uC9C0?!"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -9194723345426570509, guid: 228b3c56279d772459dcc2527efd5edf, type: 3}
    eventCommand: 
  - speakerType: 0
    speakerName: 
    text: "\uB8E8\uBBF8\uB098\uAC00 \uC870\uC2EC\uC2A4\uB7FD\uAC8C \uC4F0\uB7EC\uC9C4
      \uC2DC\uBBFC\uC5D0\uAC8C \uB2E4\uAC00\uAC04\uB2E4."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -9194723345426570509, guid: 228b3c56279d772459dcc2527efd5edf, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: ???
    text: "\uD0A4\uC5D0\uC5D0\uC5D1!!"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -9194723345426570509, guid: 228b3c56279d772459dcc2527efd5edf, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uC73C\uC545!!"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -9194723345426570509, guid: 228b3c56279d772459dcc2527efd5edf, type: 3}
    eventCommand: 
  - speakerType: 0
    speakerName: 
    text: "\uBC18\uC0AC\uC801\uC73C\uB85C \uB9C8\uBC95\uC744 \uC0AC\uC6A9\uD574 \uC801\uC744
      \uC18C\uBA78\uC2DC\uD0A8\uB2E4. \\n\uC774\uB0B4 \uACF5\uAE30\uB294 \uBB34\uAC81\uAC8C
      \uB0B4\uB824\uC549\uACE0, \uC8FC\uBCC0\uC5D4 \uACE0\uC694\uB9CC\uC774 \uB0A8\uB294\uB2E4."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -9194723345426570509, guid: 228b3c56279d772459dcc2527efd5edf, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uD5C9... \uBC29\uAE08 \uADF8\uAC74... \uBB50\uC600\uC9C0...?"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -9194723345426570509, guid: 228b3c56279d772459dcc2527efd5edf, type: 3}
    eventCommand: 
  - speakerType: 0
    speakerName: 
    text: "\uC4F0\uB7EC\uC838 \uC788\uB358 \uC2DC\uBBFC\uC774 \uC11C\uC11C\uD788
      \uC758\uC2DD\uC744 \uB418\uCC3E\uB294\uB2E4."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -9194723345426570509, guid: 228b3c56279d772459dcc2527efd5edf, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC2DC\uBBFC"
    text: "\uC73C... \uC544\uD30C..."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -9194723345426570509, guid: 228b3c56279d772459dcc2527efd5edf, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "?! \uC815\uC2E0\uC774 \uB4DC\uC2DC\uB098\uC694?"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -9194723345426570509, guid: 228b3c56279d772459dcc2527efd5edf, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "( \uBC29\uAE08 \uADF8 \uC774\uC0C1\uD55C \uC0DD\uBA85\uCCB4\uB97C \uC18C\uBA78
      \uC2DC\uD0A4\uB2C8, \uC758\uC2DD\uC744 \uB418\uCC3E\uC558\uC5B4.)"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -9194723345426570509, guid: 228b3c56279d772459dcc2527efd5edf, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "( \uC124\uB9C8\u2026 \uADF8 \uC0DD\uBA85\uCCB4\uAC00 \uC0AC\uB78C\uC744
      \uC870\uC885\uD558\uACE0 \uC788\uC5C8\uB358 \uAC74\uAC00?)"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -9194723345426570509, guid: 228b3c56279d772459dcc2527efd5edf, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC2DC\uBBFC"
    text: "\uC5EC\uAE34... \uC5B4\uB514\uC8E0...?"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -9194723345426570509, guid: 228b3c56279d772459dcc2527efd5edf, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uBCA0\uC2A4\uD398\uB77C \uC678\uACFD \uC232\uC774\uC5D0\uC694. \\n\uC5EC\uAE34
      \uB9C8\uBB3C\uB4E4\uB3C4 \uC790\uC8FC \uCD9C\uBAB0\uD558\uB2C8, \uD63C\uC790
      \uB3CC\uC544\uB2E4\uB2C8\uBA74 \uC704\uD5D8\uD574\uC694."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -9194723345426570509, guid: 228b3c56279d772459dcc2527efd5edf, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC2DC\uBBFC"
    text: "\uC73C\uC73C... \uAE30\uC5B5\uC774 \uC798 \uC548 \uB098\uC694... \uBD84\uBA85
      \uC9D1 \uADFC\uCC98\uC5D0\uC11C \uAC77\uACE0 \uC788\uC5C8\uB294\uB370..."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -9194723345426570509, guid: 228b3c56279d772459dcc2527efd5edf, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uD760\u2026\uBB34\uC5B8\uAC00\uC5D0\uAC8C \uC2B5\uACA9\uB2F9\uD55C \uAE30\uC5B5\uC740
      \uC5C6\uC73C\uC2E0\uAC00\uC694?"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -9194723345426570509, guid: 228b3c56279d772459dcc2527efd5edf, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC2DC\uBBFC"
    text: "\uC798 \uBAA8\uB974\uACA0\uC5B4\uC694\u2026 \uC544\uBB34\uAC83\uB3C4 \uB5A0\uC624\uB974\uC9C8
      \uC54A\uB124\uC694\u2026"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -9194723345426570509, guid: 228b3c56279d772459dcc2527efd5edf, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uADF8\uB807\uAD70\uC694... \uC77C\uB2E8 \uC5EC\uAE34 \uC704\uD5D8\uD558\uB2C8,
      \uB9C8\uC744\uB85C \uB3CC\uC544\uAC00\uC2DC\uB294 \uAC8C \uC88B\uACA0\uC5B4\uC694."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -9194723345426570509, guid: 228b3c56279d772459dcc2527efd5edf, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC2DC\uBBFC"
    text: "\uC815\uB9D0 \uAC10\uC0AC\uD569\uB2C8\uB2E4, \uB9C8\uB140\uB2D8\u2026"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -9194723345426570509, guid: 228b3c56279d772459dcc2527efd5edf, type: 3}
    eventCommand: 
