  m_Script: {fileID: 11500000, guid: 6d9aab5c9c9d22b43bf5c4fdd35c67ef, type: 3}
  m_Name: Story_1_3
  m_EditorClassIdentifier: 
  introTitle: 
  introDescription: "\uB9C8\uB140\uD68C"
  backgroundSprite: {fileID: 2996479508777163340, guid: 838daae80bd27204b984d96f42539621, type: 3}
  isIllustrationMode: 0
  illustrationSprite: {fileID: 0}
  tsvFile: {fileID: 4900000, guid: 055440b24911f7042853b793ef87d6d3, type: 3}
  lines:
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uC624\uB79C\uB9CC\uC5D0 \uC624\uB294 \uAC83 \uAC19\uC740\uB370, \uBCC0\uD568\uC5C6\uB294
      \uBAA8\uC2B5\uC774\uB124."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 0}
  - speakerType: 0
    speakerName: 
    text: "\uB8E8\uBBF8\uB098\uAC00 \uB9C8\uB140\uD68C\uC5D0 \uB3C4\uCC29\uD558\uC790,
      \uC55E\uCABD\uC5D0\uC11C \uC0AC\uB78C\uB4E4\uC758 \uC6C5\uC131\uAC70\uB9AC\uB294
      \uBAA9\uC18C\uB9AC\uAC00 \uB4E4\uB824\uC654\uB2E4"
    leftSprite: {fileID: 0}
    rightSprite: {fileID: 0}
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uC751? \uBB50\uAC00 \uC774\uB9AC \uC18C\uB780 \uC2A4\uB7FD\uC9C0? \uBB34\uC2A8
      \uC77C\uC774 \uC77C\uC5B4\uB09C\uAC78\uAE4C?"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 0}
  - speakerType: 1
    speakerName: "\uC678\uACFD \uC8FC\uBBFC1"
    text: "\uC694\uC998 \uB4E4\uC5B4\u2026 \uC778\uAC04\uB4E4\uC774 \uC6B0\uB9AC
      \uB9C8\uC744 \uADFC\uCC98\uB85C \uC790\uC8FC \uB098\uD0C0\uB0A9\uB2C8\uB2E4."
    leftSprite: {fileID: 5019755803035297149, guid: d6d4bf7051a0a5549a10985d97b29431, type: 3}
    rightSprite: {fileID: 0}
  - speakerType: 1
    speakerName: "\uC678\uACFD \uC8FC\uBBFC1"
    text: "\uADF8\uB7F0\uB370 \uC0C1\uD0DC\uAC00 \uC9C4\uC9DC \uC774\uC0C1\uD558\uB354\uB77C\uACE0\uC694..
      \uAC00\uB9CC\uD788 \uC788\uB2E4\uAC00 \uAC11\uC790\uAE30 \uACF5\uACA9\uC801\uC73C\uB85C
      \uB3CC\uBCC0\uD574\uC694."
    leftSprite: {fileID: 5019755803035297149, guid: d6d4bf7051a0a5549a10985d97b29431, type: 3}
    rightSprite: {fileID: 0}
  - speakerType: 1
    speakerName: "\uC678\uACFD \uC8FC\uBBFC1"
    text: "\uACB0\uAD6D \uB9C8\uB825\uAE4C\uC9C0 \uC4F0\uAC8C \uB410\uACE0\uC694.
      \uC774\uB798\uC11C\uC57C \uB3C4\uC800\uD788 \uBABB \uACAC\uB514\uACA0\uC5B4\uC694."
    leftSprite: {fileID: 5019755803035297149, guid: d6d4bf7051a0a5549a10985d97b29431, type: 3}
    rightSprite: {fileID: 0}
  - speakerType: 1
    speakerName: "\uC678\uACFD \uC8FC\uBBFC1"
    text: "\uC6D0\uB798 \uC778\uAC04\uC744 \uB2E4\uCE58\uAC8C \uD574\uC11C\uB294
      \uC548 \uB418\uC796\uC544\uC694?"
    leftSprite: {fileID: 5019755803035297149, guid: d6d4bf7051a0a5549a10985d97b29431, type: 3}
    rightSprite: {fileID: 0}
  - speakerType: 1
    speakerName: "\uC678\uACFD \uC8FC\uBBFC1"
    text: "\uC800\uB3C4 \uC778\uAC04\uC744 \uD574\uCE58\uACE0 \uC2F6\uC9C0 \uC54A\uC740\uB370
      \uB9D0\uC774\uC8E0\u2026"
    leftSprite: {fileID: 5019755803035297149, guid: d6d4bf7051a0a5549a10985d97b29431, type: 3}
    rightSprite: {fileID: 0}
  - speakerType: 2
    speakerName: "\uC678\uACFD \uC8FC\uBBFC2"
    text: "\uC774 \uAC83\uBD10! \uB098\uB9CC \uADF8\uB7F0\uAC8C \uC544\uB2C8\uC5C8\uAD70!"
    leftSprite: {fileID: 5019755803035297149, guid: d6d4bf7051a0a5549a10985d97b29431, type: 3}
    rightSprite: {fileID: -2726098593314196821, guid: f6e4948c50597304c91e3728b376dcac, type: 3}
  - speakerType: 2
    speakerName: "\uC678\uACFD \uC8FC\uBBFC2"
    text: "\uC6B0\uB9AC \uB9C8\uC744\uC5D0\uC11C\uB3C4 \uBE44\uC2B7\uD55C \uC77C\uC774
      \uC790\uC8FC \uC77C\uC5B4\uB098\uC694!"
    leftSprite: {fileID: 5019755803035297149, guid: d6d4bf7051a0a5549a10985d97b29431, type: 3}
    rightSprite: {fileID: -2726098593314196821, guid: f6e4948c50597304c91e3728b376dcac, type: 3}
  - speakerType: 2
    speakerName: "\uC678\uACFD \uC8FC\uBBFC2"
    text: "\uC778\uADFC \uC601\uC9C0 \uC8FC\uBBFC\uC778 \uAC83 \uAC19\uC740\uB370,
      \uC6B0\uB9AC \uB9C8\uC744\uACFC \uBB34\uC5B8\uAC00 \uAD00\uB828\uC774 \uC788\uB294
      \uAC74\uAC00\uC694?"
    leftSprite: {fileID: 5019755803035297149, guid: d6d4bf7051a0a5549a10985d97b29431, type: 3}
    rightSprite: {fileID: -2726098593314196821, guid: f6e4948c50597304c91e3728b376dcac, type: 3}
  - speakerType: 2
    speakerName: "\uC678\uACFD \uC8FC\uBBFC2"
    text: "\uBD88\uC548\uD574\uC11C \uC694\uC0C8 \uC7A0\uB3C4 \uC798 \uBABB \uC790\uACA0\uC5B4\uC694!"
    leftSprite: {fileID: 5019755803035297149, guid: d6d4bf7051a0a5549a10985d97b29431, type: 3}
    rightSprite: {fileID: -2726098593314196821, guid: f6e4948c50597304c91e3728b376dcac, type: 3}
  - speakerType: 1
    speakerName: "\uACF5\uBB34\uC6D0 \uB9C8\uB140"
    text: "\uD734\u2026\uC624\uB298\uB9CC \uBA87 \uAC74 \uC9F8\uC57C.."
    leftSprite: {fileID: 6072800664941456165, guid: d4b143eaa913d774490e4b12f1789345, type: 3}
    rightSprite: {fileID: -2726098593314196821, guid: f6e4948c50597304c91e3728b376dcac, type: 3}
  - speakerType: 1
    speakerName: "\uACF5\uBB34\uC6D0 \uB9C8\uB140"
    text: "\uC800\uD76C\uB3C4 \uC694\uC998 \uBE44\uC2B7\uD55C \uBBFC\uC6D0\uB4E4\uC774
      \uC7A6\uC544\uC838\uC11C \uD63C\uB780\uC2A4\uB7FD\uC2B5\uB2C8\uB2E4."
    leftSprite: {fileID: 6072800664941456165, guid: d4b143eaa913d774490e4b12f1789345, type: 3}
    rightSprite: {fileID: -2726098593314196821, guid: f6e4948c50597304c91e3728b376dcac, type: 3}
  - speakerType: 1
    speakerName: "\uACF5\uBB34\uC6D0 \uB9C8\uB140"
    text: "\uAC19\uC740 \uC0AC\uAC74\uC73C\uB85C \uBB36\uC5B4\uC11C \uCC98\uB9AC
      \uC911\uC774\uB2C8\uAE4C, \uC9C4\uC815 \uD574 \uC8FC\uC138\uC694."
    leftSprite: {fileID: 6072800664941456165, guid: d4b143eaa913d774490e4b12f1789345, type: 3}
    rightSprite: {fileID: -2726098593314196821, guid: f6e4948c50597304c91e3728b376dcac, type: 3}
  - speakerType: 2
    speakerName: "\uC678\uACFD \uC8FC\uBBFC2"
    text: "\uADF8\uAC8C \uB300\uCCB4 \uC5B8\uC81C\uAE4C\uC9C0 \uC9C4\uD589\uB418\uB294
      \uAC81\uB2C8\uAE4C?\_ \uADF8\uC800 \uD574\uACB0\uB418\uAE30\uB97C \uBC14\uB77C\uBA74\uC11C
      \uC788\uB294 \uAC8C \uB354 \uBD88\uC548\uD569\uB2C8\uB2E4!!"
    leftSprite: {fileID: 6072800664941456165, guid: d4b143eaa913d774490e4b12f1789345, type: 3}
    rightSprite: {fileID: -2726098593314196821, guid: f6e4948c50597304c91e3728b376dcac, type: 3}
  - speakerType: 1
    speakerName: "\uACF5\uBB34\uC6D0 \uB9C8\uB140"
    text: "\uD558\uC9C0\uB9CC \uC9C0\uAE08 \uB2F9\uC7A5 \uD574 \uB4DC\uB9B4 \uC218
      \uC788\uB294 \uAC8C \uC5C6\uC2B5\uB2C8\uB2E4\u2026"
    leftSprite: {fileID: 6072800664941456165, guid: d4b143eaa913d774490e4b12f1789345, type: 3}
    rightSprite: {fileID: -2726098593314196821, guid: f6e4948c50597304c91e3728b376dcac, type: 3}
  - speakerType: 0
    speakerName: 
    text: "\uBBFC\uC6D0 \uC811\uC218\uCC98 \uACF5\uBB34\uC6D0 \uB9C8\uB140\uAC00
      \uB09C\uCC98\uD55C \uC5BC\uAD74\uB85C \uC8FC\uBBFC\uB4E4\uC758 \uBBFC\uC6D0\uC744
      \uC815\uB9AC\uD558\uACE0 \uC788\uC744 \uB54C, \uAC11\uC790\uAE30 \uBB38\uC774
      \uC5F4\uB9AC\uBA70 \uC775\uC219\uD55C \uAE30\uC6B4\uC774 \uB290\uAEF4\uC9C4\uB2E4"
    leftSprite: {fileID: 6072800664941456165, guid: d4b143eaa913d774490e4b12f1789345, type: 3}
    rightSprite: {fileID: -2726098593314196821, guid: f6e4948c50597304c91e3728b376dcac, type: 3}
  - speakerType: 2
    speakerName: ???
    text: "\uBBD5\u2026\uBB50\uAC00 \uC774\uB9AC \uC18C\uB780\uC2A4\uB7EC\uC6CC?"
    leftSprite: {fileID: 6072800664941456165, guid: d4b143eaa913d774490e4b12f1789345, type: 3}
    rightSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
  - speakerType: 1
    speakerName: "\uACF5\uBB34\uC6D0 \uB9C8\uB140"
    text: "\uC544\uC774\uB9B0 \uACFC\uC7A5\uB2D8.."
    leftSprite: {fileID: 6072800664941456165, guid: d4b143eaa913d774490e4b12f1789345, type: 3}
    rightSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
  - speakerType: 0
    speakerName: 
    text: "\uACF5\uBB34\uC6D0 \uB9C8\uB140\uB294 \uAC04\uC808\uD55C \uB208\uBE5B\uC73C\uB85C
      \uC544\uC774\uB9B0\uC744 \uBC14\uB77C\uBCF8\uB2E4."
    leftSprite: {fileID: 6072800664941456165, guid: d4b143eaa913d774490e4b12f1789345, type: 3}
    rightSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
  - speakerType: 2
    speakerName: "\uC544\uC774\uB9B0"
    text: "\uD750\uC74C~ \uADF8\uB798.. \uC54C\uACA0\uC5B4.."
    leftSprite: {fileID: 6072800664941456165, guid: d4b143eaa913d774490e4b12f1789345, type: 3}
    rightSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
  - speakerType: 2
    speakerName: "\uC544\uC774\uB9B0"
    text: "\uC8FC\uBBFC \uC5EC\uB7EC\uBD84, \uB108\uBB34 \uAC71\uC815\uD558\uC9C0
      \uB9C8\uC2ED\uC2DC\uC624."
    leftSprite: {fileID: 6072800664941456165, guid: d4b143eaa913d774490e4b12f1789345, type: 3}
    rightSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
  - speakerType: 2
    speakerName: "\uC544\uC774\uB9B0"
    text: "\uC800\uD76C\uAC00 \uC0AC\uAC74\uC758 \uC6D0\uC778\uC744 \uCCA0\uC800\uD788
      \uC870\uC0AC\uD558\uC5EC, \uC778\uAC04\uB4E4\uC774 \uD568\uBD80\uB85C \uB4E4\uC5B4\uC624\uC9C0
      \uBABB\uD558\uB3C4\uB85D \uC870\uCE58\uB97C \uCDE8\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    leftSprite: {fileID: 6072800664941456165, guid: d4b143eaa913d774490e4b12f1789345, type: 3}
    rightSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
  - speakerType: 1
    speakerName: "\uC678\uACFD \uC8FC\uBBFC2"
    text: "\uC624\uC624..! \uC544\uC774\uB9B0\uB2D8\uC774\uC2DC\uAD70\uC694! \uC9C1\uC811
      \uB098\uC11C \uC8FC\uC2E0\uB2E4\uB2C8 \uC548\uC2EC\uC774 \uB429\uB2C8\uB2E4."
    leftSprite: {fileID: -2726098593314196821, guid: f6e4948c50597304c91e3728b376dcac, type: 3}
    rightSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
  - speakerType: 1
    speakerName: "\uC678\uACFD \uC8FC\uBBFC2"
    text: "\uB2E4\uC2DC\uB294 \uC778\uAC04\uB4E4\uC774 \uB4E4\uC5B4\uC624\uC9C0 \uBABB\uD558\uB3C4\uB85D
      \uAF2D \uC870\uCE58\uD574 \uC8FC\uC2DC\uAE38 \uBC14\uB78D\uB2C8\uB2E4!"
    leftSprite: {fileID: -2726098593314196821, guid: f6e4948c50597304c91e3728b376dcac, type: 3}
    rightSprite: {fileID: -395058365, guid: 4499765106cd484429308e64bf172d9d, type: 3}
  - speakerType: 0
    speakerName: 
    text: "\uBE44\uC2B7\uD55C \uBBFC\uC6D0\uC744 \uC811\uC218\uD558\uB824\uB358 \uC0AC\uB78C\uB4E4\uC774
      \uD558\uB098\uB458\uC529 \uB3CC\uC544\uAC00\uAE30 \uC2DC\uC791\uD588\uB2E4."
    leftSprite: {fileID: 0}
    rightSprite: {fileID: 0}
  - speakerType: 2
    speakerName: "\uC544\uC774\uB9B0"
    text: "\uD558\uD558, \uC8FC\uBBFC\uBD84\uB4E4\uC744 \uC0C1\uB300\uD558\uB290\uB77C
      \uACE0\uC0DD\uC774 \uB9CE\uB124."
    leftSprite: {fileID: 6072800664941456165, guid: d4b143eaa913d774490e4b12f1789345, type: 3}
    rightSprite: {fileID: -395058365, guid: 4499765106cd484429308e64bf172d9d, type: 3}
  - speakerType: 2
    speakerName: "\uC544\uC774\uB9B0"
    text: "\uC77C\uB2E8, \uC778\uAC04\uB4E4\uB85C \uC778\uD574 \uD53C\uD574\uB97C
      \uC785\uC740 \uC8FC\uBBFC\uB4E4\uC758 \uBA85\uB2E8\uC744\_ \uC880 \uC791\uC131\uD574\uC918.
      \uADF8 \uB2E4\uC74C\uC5D4 \uB0B4\uAC00 \uCC98\uB9AC\uD560\uAC8C."
    leftSprite: {fileID: 6072800664941456165, guid: d4b143eaa913d774490e4b12f1789345, type: 3}
    rightSprite: {fileID: -395058365, guid: 4499765106cd484429308e64bf172d9d, type: 3}
  - speakerType: 1
    speakerName: "\uACF5\uBB34\uC6D0 \uB9C8\uB140"
    text: "\uB124! \uC54C\uACA0\uC2B5\uB2C8\uB2E4."
    leftSprite: {fileID: 6072800664941456165, guid: d4b143eaa913d774490e4b12f1789345, type: 3}
    rightSprite: {fileID: -395058365, guid: 4499765106cd484429308e64bf172d9d, type: 3}
  - speakerType: 0
    speakerName: 
    text: "\uD3EC\uD654 \uC0C1\uD0DC\uC600\uB358 \uACF5\uAC04\uC774 \uC11C\uC11C\uD788
      \uBE44\uC6CC\uC9C0\uC790, \uB8E8\uBBF8\uB098\uB294 \uC544\uC774\uB9B0\uC5D0\uAC8C
      \uB2E4\uAC00\uAC14\uB2E4."
    leftSprite: {fileID: 0}
    rightSprite: {fileID: 0}
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uC2A4\uC2B9\uB2D8, \uC624\uB298\uB3C4 \uACE0\uC0DD\uC774 \uB9CE\uC73C\uC2DC\uB124\uC694.
      \uBD80\uD0C1\uD558\uC2E0 \uC7AC\uB8CC \uAC00\uC838\uC628 \uAE40\uC5D0 \uC9C1\uC811
      \uB9CC\uB4E0 \uCFE0\uD0A4\uB791 \uD64D\uCC28\uB3C4 \uC900\uBE44\uD588\uB294\uB370
      \uC880 \uB4DC\uC2DC\uACA0\uC5B4\uC694?"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -395058365, guid: 4499765106cd484429308e64bf172d9d, type: 3}
  - speakerType: 2
    speakerName: "\uC544\uC774\uB9B0"
    text: "\uBB50\uC5B4~? \uC9C1\uC811 \uB9CC\uB4E0 \uCFE0\uD0A4\uB77C\uACE0? \uC774\uAC74
      \uAC70\uC808\uD560 \uC218 \uC5C6\uACA0\uB294\uB370~?!"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -395058365, guid: 4499765106cd484429308e64bf172d9d, type: 3}
  - speakerType: 2
    speakerName: "\uC544\uC774\uB9B0"
    text: "\uADF8\uB7FC~ \uC7A0\uC2DC \uC26C\uB294 \uAE40\uC5D0 \uC798 \uBA39\uC744\uAC8C!!"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -395058365, guid: 4499765106cd484429308e64bf172d9d, type: 3}
  - speakerType: 2
    speakerName: "\uC544\uC774\uB9B0"
    text: "\uADF8\uB7F0\uB370 \uC77C\uD558\uB294 \uACF3\uC5D0\uC11C \uBA39\uAE30\uC5D4
      \uC880 \uADF8\uB798\uC11C, \uC6B0\uC120 \uC7A5\uC18C\uB97C \uC62E\uACA8\uC11C
      \uAC19\uC774 \uBA39\uC790!"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -395058365, guid: 4499765106cd484429308e64bf172d9d, type: 3}
  - speakerType: 2
    speakerName: "\uC544\uC774\uB9B0"
