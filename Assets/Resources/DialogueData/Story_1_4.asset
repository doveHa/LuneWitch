  m_Script: {fileID: 11500000, guid: 6d9aab5c9c9d22b43bf5c4fdd35c67ef, type: 3}
  m_Name: Story_1_4
  m_EditorClassIdentifier: 
  introTitle: 
  introDescription: 
  backgroundSprite: {fileID: -7917261364429478005, guid: d1493184128de1547a760c6d193e411b, type: 3}
  isIllustrationMode: 1
  illustrationSprite: {fileID: 7227120680640278575, guid: 39a55d602c96db649a4f6085cbde7ace, type: 3}
  tsvFile: {fileID: 4900000, guid: 1a7500c935c17004fb4b45844d50d407, type: 3}
  lines:
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uD788\uD788 \uB9DB\uC788\uC8E0? \uC774\uBC88\uC5D0 \uCFE0\uD0A4\uAC00
      \uB9DB\uC788\uAC8C \uAD6C\uC6CC\uC84C\uB354\uB77C\uAD6C\uC694! \uADF8\uB9AC\uACE0
      \uC774 \uC548\uC5D0 \uAE30\uC6B4\uC744 \uBD81\uB3CB\uC744 \uC218 \uC788\uB3C4\uB85D
      \uB9C8\uBC95 \uC7AC\uB8CC\uB3C4 \uC870\uAE08 \uB123\uC5B4\uBD24\uC5B4\uC694!"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    eventCommand: CG:Story illustration
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uC544, \uCC28\uB3C4 \uC900\uBE44\uD588\uC5B4\uC694! \uB728\uAC70\uC6B0\uB2C8\uAE4C
      \uACFC\uC790\uB791 \uD568\uAED8 \uCC9C\uCC9C\uD788 \uB4DC\uC154\uBCF4\uC138\uC694."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC544\uC774\uB9B0"
    text: "\uC5ED\uC2DC \uB108 \uBC16\uC5D0 \uC5C6\uB2E4\uB2C8\uAE4C! \uB0B4\uAC00
      \uC81C\uC790 \uD558\uB098\uB294 \uC798 \uB454\uAC83 \uAC19\uB2E8 \uB9D0\uC774\uC9C0."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC544\uC774\uB9B0"
    text: "\uC5ED\uC2DC \uB108 \uBC16\uC5D0 \uC5C6\uB2E4\uB2C8\uAE4C! \uB0B4\uAC00
      \uC81C\uC790 \uD558\uB098\uB294 \uC798 \uB454\uAC83 \uAC19\uB2E8 \uB9D0\uC774\uC9C0."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uC785\uB9DB\uC5D0 \uB9DE\uC73C\uC154\uC11C \uB2E4\uD589\uC774\uC5D0\uC694.
      \uC0AC\uC2E4 \uB9D0\uC500\uB4DC\uB9B4\uAC8C \uC788\uC5B4\uC694."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC544\uC774\uB9B0"
    text: "\uC6C5 \uBA4D\uB370 \uB9D0\uD574\uBD25 \uC6C5\uB0E0"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uBC29\uAE08 \uB4E4\uC73C\uC2E0 \uBBFC\uC6D0 \uB0B4\uC6A9\uC5D0 \uC5F0\uAD00\uB41C
      \uC774\uC57C\uAE30\uC5D0\uC694. \uC0AC\uC2E4 \uC800\uB3C4 \uC624\uB298 \uBE44\uC2B7\uD55C
      \uC77C\uC744 \uACAA\uC5C8\uC5B4\uC694."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    eventCommand: 
  - speakerType: 0
    speakerName: 
    text: "\uB8E8\uBBF8\uB098\uAC00 \uC624\uB298 \uC788\uC5C8\uB358 \uC77C\uC744
      \uC774\uC57C\uAE30\uD55C\uB2E4."
    leftSprite: {fileID: 0}
    rightSprite: {fileID: 0}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uAC00\uC7A5 \uC218\uC0C1\uD55C \uAC74\u2026 \uADF8 \uBD84\uC744 \uC870\uC885\uD558\uACE0
      \uC788\uB294 \uAC83\uCC98\uB7FC \uBCF4\uC774\uB358 \uC0DD\uBA85\uCCB4\uC5D0\uC694.
      \uAC11\uC790\uAE30 \uC800\uB97C \uACF5\uACA9\uD558\uB824\uACE0 \uD574\uC11C\u2026
      \uBB34\uC2ED\uCF54 \uC18C\uBA78\uC2DC\uCF1C\uBC84\uB838\uC5B4\uC694."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uC0AC\uAC74\uC758 \uC6D0\uC778\uC744 \uD30C\uC545\uD560 \uC218 \uC788\uB294
      \uAE30\uD68C\uC600\uB294\uB370, \uC544\uC27D\uB124\uC694.."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -395058365, guid: 4499765106cd484429308e64bf172d9d, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC544\uC774\uB9B0"
    text: "\uD558\uD558! \uC798\uD588\uC5B4! \uC704\uD5D8\uD55C \uC0C1\uD669\uC774\uC5C8\uB358
      \uAC83 \uAC19\uC740\uB370, \uADF8 \uB54C \"\uADF8\uAC78\" \uC8FD\uC774\uC9C0
      \uC54A\uC558\uB2E4\uBA74 \uC624\uB298 \uC774 \uB9DB\uC788\uB294 \uCFE0\uD0A4\uB3C4
      \uB9DB \uBCFC \uC218 \uC5C6\uC5C8\uC744\uAC70\uC57C."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -395058365, guid: 4499765106cd484429308e64bf172d9d, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uADF8\uB798\uB3C4... \uC81C\uAC00 \uADF8 \uB54C \uC880\uB354 \uACBD\uACC4\uD588\uC5C8\uB2E4\uBA74
      \uC0DD\uD3EC\uD560 \uC218 \uC788\uC5C8\uC744\uD150\uB370 \uB9D0\uC774\uC8E0.."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -395058365, guid: 4499765106cd484429308e64bf172d9d, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC544\uC774\uB9B0"
    text: "\uAD1C\uCC2E\uC544. \uD558\uC9C0\uB9CC \uC774\uAC74 \uB2E8\uC21C\uD55C
      \uBB38\uC81C\uAC00 \uC544\uB2CC \uAC83 \uAC19\uC544."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -395058365, guid: 4499765106cd484429308e64bf172d9d, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC544\uC774\uB9B0"
    text: "\uCD5C\uADFC\uC5D0 \uBE44\uC2B7\uD55C \uC0AC\uAC74\uB3C4 \uACC4\uC18D
      \uC77C\uC5B4\uB098\uACE0 \uC788\uC796\uC544. \uC544\uBB34\uB798\uB3C4 \uBCA8\uBAA8\uB9AC\uC544\uC5D0
      \uC9C1\uC811 \uB2E4\uB140\uC640\uC57C \uD560 \uAC83 \uAC19\uC544."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -395058365, guid: 4499765106cd484429308e64bf172d9d, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uC601\uC8FC\uB2D8\uC744 \uBD48\uB7EC \uAC00\uB294 \uAC74\uAC00\uC694?"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -395058365, guid: 4499765106cd484429308e64bf172d9d, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC544\uC774\uB9B0"
    text: "\uB9DE\uC544, \uADFC\uB370 \uB098\uB294 \uB2E4\uB978 \uC5C5\uBB34\uB3C4
      \uB9CE\uC544\uC11C \uC2DC\uAC04\uC774 \uB420 \uC9C0 \uBAA8\uB974\uACA0\uC5B4....\uC774\uAC70
      \uCC38 \uACE8\uCE58 \uC544\uD504\uB124."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -395058365, guid: 4499765106cd484429308e64bf172d9d, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uC81C\uAC00 \uB2E4\uB140\uC640\uB3C4 \uAD1C\uCC2E\uC744\uAE4C\uC694?
      \uBCA8\uBAA8\uB9AC\uC544 \uC0C1\uC810\uAC00\uB3C4 \uB458\uB7EC\uBCF4\uACE0
      \uC2F6\uC5C8\uAC70\uB4E0\uC694!"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -395058365, guid: 4499765106cd484429308e64bf172d9d, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC544\uC774\uB9B0"
    text: "\uC624, \uADF8\uB798? \uC798\uB410\uB2E4! \uADF8\uB7FC \uC548\uC2EC\uD558\uACE0
      \uB9E1\uAE38\uAC8C. \uB9CC\uC57D \uBB34\uC2A8 \uC77C\uC774 \uC0DD\uAE30\uBA74
      \uBC14\uB85C \uC5F0\uB77D\uD574."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -395058365, guid: 4499765106cd484429308e64bf172d9d, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC544\uC774\uB9B0"
    text: "\uCD9C\uC785 \uD5C8\uAC00 \uACFC\uC815\uC740 \uB0B4\uAC00 \uCC98\uB9AC\uD560
      \uD14C\uB2C8 \uAC71\uC815 \uB9D0\uACE0. \uB108\uB77C\uBA74 \uC678\uBD80\uC5D0\uC11C
      \uB9D0\uC37D \uC548\_ \uD53C\uC6B0\uACA0\uC9C0?"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -395058365, guid: 4499765106cd484429308e64bf172d9d, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uADF8\uB7FC\uC694! \uC870\uC6A9\uD788 \uB2E4\uB140\uC62C\uAC8C\uC694."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 0}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC544\uC774\uB9B0"
    text: "\uADF8\uB798. \uACE0\uB9C8\uC6CC \uC870\uC2EC\uD788 \uB2E4\uB140\uC640."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: -395058365, guid: 4499765106cd484429308e64bf172d9d, type: 3}
    eventCommand: 
  isChapterEnd: 1
  nextSceneName: 
  nextStory: {fileID: 0}
  nextStoryAfterBattle: {fileID: 0}
