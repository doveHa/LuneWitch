  m_Name: Story_2_1
  m_EditorClassIdentifier: 
  introTitle: 
  introDescription: "\uBC88\uD654\uAC00"
  backgroundSprite: {fileID: 5798488700277797637, guid: c72b93c97910b7d4b940076412aa0cf6, type: 3}
  isIllustrationMode: 0
  illustrationSprite: {fileID: 0}
  tsvFile: {fileID: 4900000, guid: 3dc1194d4f83a5142bca8a6603871132, type: 3}
  lines:
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uC5B4\uB77C\u2026? \uC5EC\uAE30 \uBCC0\uD654\uAC00\uAC00 \uC6D0\uB798
      \uC774\uB807\uAC8C \uD55C\uC0B0\uD588\uC5C8\uB098?"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 0}
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uC778\uAC04\uB4E4\uC758 \uD754\uC801\uC774 \uB108\uBB34 \uC5C6\uB294\uB370,
      \uB9C8\uCE58 \uAC11\uC790\uAE30 \uBAA8\uB450\uAC00 \uC99D\uBC1C \uD574\uBC84\uB9B0
      \uAC83 \uAC19\uC544."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 0}
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uADF8\uB7F4 \uB9AC \uC5C6\uB2E4\uB294 \uAC74 \uC54C\uC9C0\uB9CC, \uC774
      \uAD11\uACBD\uC744 \uADF8\uB0E5 \uC9C0\uB098\uCE58\uAE30\uB294 \uC5B4\uB824\uC6CC."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 0}
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uBB54\uAC00 \uC2EC\uC0C1\uCE58 \uC54A\uC740 \uC77C\uC774 \uC77C\uC5B4\uB098\uACE0
      \uC788\uB294 \uAC83 \uAC19\uC544."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 0}
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uC778\uAC04\uB4E4\uC774 \uC5C6\uB2E4 \uBCF4\uB2C8 \uC81C\uB300\uB85C
      \uC0B4\uD3B4\uBCFC \uC218 \uB3C4 \uC5C6\uACE0.."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 0}
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uC774\uAC8C \uB300\uCCB4 \uBB34\uC2A8 \uC77C\uC77C\uAE4C\u2026"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 0}
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uC601\uC8FC\uB2D8\uAED8 \uD55C \uBC88 \uAC00 \uBD10\uC57C\uACA0\uC5B4."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 0}
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uC5B4\uCA4C\uBA74 \uC601\uC8FC\uB2D8\uC774 \uBB54\uAC00 \uC54C\uACE0
      \uACC4\uC2E4\uC9C0\uB3C4 \uBAB0\uB77C."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 0}
  isChapterEnd: 0
  nextSceneName: 
  nextStory: {fileID: 0}
  nextStoryAfterBattle: {fileID: 0}
