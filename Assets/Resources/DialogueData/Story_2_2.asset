  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6d9aab5c9c9d22b43bf5c4fdd35c67ef, type: 3}
  m_Name: Story_2_2
  m_EditorClassIdentifier: 
  introTitle: 
  introDescription: "\uADF8 \uC2DC\uAC01 \uB9C8\uB140\uD68C \uD68C\uC758\uC7A5"
  bgm: {fileID: 8300000, guid: dd1b97b8a91ccf749ae84d60637acaef, type: 3}
  backgroundSprite: {fileID: -5029804501114162806, guid: f2e451542dca25941a123b0f85419b2b, type: 3}
  isIllustrationMode: 0
  illustrationSprite: {fileID: 0}
  tsvFile: {fileID: 4900000, guid: 665b74c2b721c3d45a6733d2eadfa490, type: 3}
  lines:
  - speakerType: 1
    speakerName: "\uC544\uC774\uB9B0"
    text: "\uB2E4\uB4E4 \uBC14\uC05C\uB370 \uC640\uC918\uC11C\uACE0\uB9C8\uC6CC. 
      \\n\uC774\uB807\uAC8C \uB2E4\uAC19\uC774 \uBAA8\uC774\uB294 \uAC74 \uC815\uB9D0
      \uC624\uB79C\uB9CC\uC774\uB124."
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: 0}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uCE74\uB974\uC138\uC774\uB77C"
    text: "\uD765,\_ \uBCC4 \uAC70 \uC544\uB2CC\uAC78\uB85C \uC6B0\uB9AC\uB97C \uC774\uB807\uAC8C
      \uBD80\uB978 \uAC74 \uC544\uB2C8\uACA0\uC9C0?"
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: -20122045393276472, guid: cfb15810cd3f2824f85eaab152e97c2c, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uC544\uC774\uB9B0"
    text: "\uC751 \uC774\uAC74 \uC911\uC694\uD55C \uC0AC\uD56D\uC774 \uB420 \uAC83
      \uAC19\uC544\uC11C \uD68C\uC758\uB97C \uC8FC\uCD5C\uD55C\uAC70\uC57C."
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: -20122045393276472, guid: cfb15810cd3f2824f85eaab152e97c2c, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uCE74\uB974\uC138\uC774\uB77C"
    text: "\uC544\uC774\uB9B0. \uB610 \uADF8 \uACE8\uB54C\uB9AC\uB294 \uB108\uC758
      \uC9C1\uAC10 \uB54C\uBB38\uC5D0 \uC774\uB7EC\uB294 \uAC70\uB77C\uBA74 \uB098\uB294
      \uB3CC\uC544\uAC00\uACA0\uC5B4."
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: -20122045393276472, guid: cfb15810cd3f2824f85eaab152e97c2c, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uC544\uC774\uB9B0"
    text: "\uC5D0\uC774 ... \uB108\uBB34 \uADF8\uB7EC\uC9C0 \uB9D0\uACE0 \uD55C \uBC88\uC774\uB77C\uB3C4
      \uB0B4 \uC774\uC57C\uAE30\uB97C \uB4E4\uC5B4\uBD10\uC92C\uC73C\uBA74 \uD574."
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: -20122045393276472, guid: cfb15810cd3f2824f85eaab152e97c2c, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uCE74\uB974\uC138\uC774\uB77C"
    text: "\uD558.. \uC5ED\uC2DC\uB098 \uADF8\uB7F0 \uAC70\uC600\uB098..? \uB09C
      \uB3CC\uC544\uAC00\uACA0\uC5B4."
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: -20122045393276472, guid: cfb15810cd3f2824f85eaab152e97c2c, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uC544\uC774\uB9B0"
    text: "\uC7A0\uAE50\uB9CC! \uC801\uC5B4\uB3C4 \uBAA8\uB450\uD55C\uD14C \uC778\uC0AC\uB3C4
      \uB098\uB20C \uACB8 \uD55C \uBC88\uB9CC \uB0B4 \uC598\uAE30\uB97C \uB4E4\uC5B4\uC918!"
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: -20122045393276472, guid: cfb15810cd3f2824f85eaab152e97c2c, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uC544\uC774\uB9B0"
    text: "\uC9C4\uC9DC \uBE60\uB974\uAC8C \uB05D\uB0BC\uAC8C!"
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: -20122045393276472, guid: cfb15810cd3f2824f85eaab152e97c2c, type: 3}
    eventCommand: 
  - speakerType: 0
    speakerName: 
    text: "\uC544\uC774\uB9B0\uC774 \uBC18\uC9DD\uC774\uB294 \uB208\uC73C\uB85C \uBD80\uD0C1\uD55C\uB2E4.."
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: -20122045393276472, guid: cfb15810cd3f2824f85eaab152e97c2c, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uCE74\uB974\uC138\uC774\uB77C"
    text: "\uD765, \uC7A0\uAE50\uC774\uC57C. \uBE60\uB974\uAC8C \uB05D\uB0B4.  \\n\uB0B4
      \uC2DC\uAC04\uC774 \uC544\uAE5D\uC9C0 \uC54A\uAC8C \uD558\uB294\uAC8C \uC88B\uC744
      \uAC70\uC57C."
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: -20122045393276472, guid: cfb15810cd3f2824f85eaab152e97c2c, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uC544\uC774\uB9B0"
    text: "\u314E\u314E\uACE0\uB9C8\uC6CC! \uC5ED\uC2DC \uB10C \uC815\uB9D0 \uCD5C\uACE0\uC758
      \uCE5C\uAD6C\uC57C!"
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: -20122045393276472, guid: cfb15810cd3f2824f85eaab152e97c2c, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uC774\uB9AC\uC5D8"
    text: "\uD750\uC751~ \uADF8 \uC5EC\uD3EC \uAC19\uC740 \uCE74\uB974\uC138\uC774\uB77C\uAC00
      \uC774\uB807\uAC8C \uC27D\uAC8C \uC838\uC8FC\uB294 \uC131\uACA9\uC774 \uC544\uB2D0\uD150\uB370."
    leftSprite: {fileID: 652121894626912164, guid: 44b1bb5ad7b7e71489e18634a12d4487, type: 3}
    rightSprite: {fileID: -20122045393276472, guid: cfb15810cd3f2824f85eaab152e97c2c, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uC774\uB9AC\uC5D8"
    text: "\uC5ED\uC2DC \uC544\uC774\uB9B0\uC740 \uB300\uB2E8\uD558\uB2E4\uB2C8\uAE4C~?"
    leftSprite: {fileID: 652121894626912164, guid: 44b1bb5ad7b7e71489e18634a12d4487, type: 3}
    rightSprite: {fileID: -20122045393276472, guid: cfb15810cd3f2824f85eaab152e97c2c, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uCE74\uB974\uC138\uC774\uB77C"
    text: "\uC785 \uB180\uB9AC\uB294 \uAC74 \uC5EC\uC804\uD558\uAD70, \uC774\uB9AC\uC5D8."
    leftSprite: {fileID: 652121894626912164, guid: 44b1bb5ad7b7e71489e18634a12d4487, type: 3}
    rightSprite: {fileID: -20122045393276472, guid: cfb15810cd3f2824f85eaab152e97c2c, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uCE74\uB974\uC138\uC774\uB77C"
    text: "\uC804\uC7A5\uC5D0\uC11C \uB0A0 \uB9C8\uC8FC\uCCE4\uB2E4\uBA74, \uB124
      \uD600\uBD80\uD130 \uC798\uB77C\uC92C\uC744 \uAC70\uC57C.\\n\uC5EC\uAE30\uB97C
      \uC804\uC7A5\uC73C\uB85C \uB9CC\uB4E4\uACE0 \uC2F6\uC9C0 \uC54A\uB2E4\uBA74
      \uB9D0\uC774\uC9C0."
    leftSprite: {fileID: 652121894626912164, guid: 44b1bb5ad7b7e71489e18634a12d4487, type: 3}
    rightSprite: {fileID: -20122045393276472, guid: cfb15810cd3f2824f85eaab152e97c2c, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uBCA0\uB974\uC81C\uC778"
    text: "\uCC38, \uC80A\uC740 \uD53C\uB4E4 \uC2F8\uC6B0\uB294 \uBAA8\uC2B5\uC740
      \uBCFC \uB54C\uB9C8\uB2E4 \uC9C8\uB9AC\uC9C0 \uC54A\uB124."
    leftSprite: {fileID: 5446078680231761675, guid: b1ec169d5f450e24a910eacadf1ec4f9, type: 3}
    rightSprite: {fileID: -20122045393276472, guid: cfb15810cd3f2824f85eaab152e97c2c, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uBCA0\uB974\uC81C\uC778"
    text: "\uADFC\uB370 \uB9D0\uC774\uC57C, \uC6B0\uB9B0 \uB180\uC790\uACE0 \uBAA8\uC778
      \uAC70 \uC544\uB2C8\uC9C0?"
    leftSprite: {fileID: 5446078680231761675, guid: b1ec169d5f450e24a910eacadf1ec4f9, type: 3}
    rightSprite: {fileID: -20122045393276472, guid: cfb15810cd3f2824f85eaab152e97c2c, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uBCA0\uB974\uC81C\uC778"
    text: "\uAC10\uC815\uC740 \uB098\uC911\uC5D0 \uD480\uACE0, \uD68C\uC758\uB2F5\uAC8C
      \uC880 \uAD74\uC5B4\uBCF4\uC790\uACE0."
    leftSprite: {fileID: 5446078680231761675, guid: b1ec169d5f450e24a910eacadf1ec4f9, type: 3}
    rightSprite: {fileID: -20122045393276472, guid: cfb15810cd3f2824f85eaab152e97c2c, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uB77C\uBE44\uB2C8\uC544"
    text: "\u2026\uC2A4\uC2B9\uB2D8\uC774 \uC65C \uD68C\uC758\uB294 \uB298 \uD53C\uD558\uC168\uB294\uC9C0\u2026
      \uC870\uAE08 \uC54C \uAC83 \uAC19\uC544\uC694\u2026"
    leftSprite: {fileID: 5446078680231761675, guid: b1ec169d5f450e24a910eacadf1ec4f9, type: 3}
    rightSprite: {fileID: -4798111988831281657, guid: 5875437039abab04486fba29f3728f4c, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB098\uC774\uC544"
    text: "\u2026."
    leftSprite: {fileID: 1113943883041212095, guid: 2c8fc658780b80f49a2c59da4d623714, type: 3}
    rightSprite: {fileID: -4798111988831281657, guid: 5875437039abab04486fba29f3728f4c, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC544\uC774\uB9B0"
    text: "\uD558\uD558 , \uC5ED\uC2DC \uB5A0\uB4E4\uC369\uD574\uC9C0\uB2C8 \uC61B\uB0A0
      \uC0DD\uAC01\uB098\uACE0 \uC88B\uB124~!"
    leftSprite: {fileID: 1113943883041212095, guid: 2c8fc658780b80f49a2c59da4d623714, type: 3}
    rightSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC544\uC774\uB9B0"
    text: "\uADF8\uB7EC\uACE0 \uBCF4\uB2C8, \uB77C\uBE44\uB2C8\uC544 \uC2A4\uC2B9\uB2D8\uC740
      \uC624\uB298\uB3C4 \uBABB \uB098\uC624\uB098 \uBCF4\uB124?"
    leftSprite: {fileID: 1113943883041212095, guid: 2c8fc658780b80f49a2c59da4d623714, type: 3}
    rightSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB77C\uBE44\uB2C8\uC544"
    text: "\uB124\u2026\uC2A4\uC2B9\uB2D8\uAED8\uC11C\uB294 \uC624\uB298\uB3C4 \uBC14\uC058\uC2DC\uB2E4\uBA70
      \uC800\uB97C \uB9C8\uB140\uD68C\uB85C \uBCF4\uB0B4\uC168\uC5B4\uC694."
    leftSprite: {fileID: -4798111988831281657, guid: 5875437039abab04486fba29f3728f4c, type: 3}
    rightSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC544\uC774\uB9B0"
    text: "( \uD760\u2026 \uC544\uC9C1\uB3C4 \uADF8 \uC774\uC0C1\uD55C \uC2E4\uD5D8\uC744
      \uACC4\uC18D\uD558\uACE0 \uC788\uB294\uAC74\uAC00? )"
    leftSprite: {fileID: -4798111988831281657, guid: 5875437039abab04486fba29f3728f4c, type: 3}
    rightSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uC774\uB9AC\uC5D8"
    text: "\uC774\uBC88\uC5D4 \uB610 \uBB34\uC2A8 \uC7AC\uBC0C\uB294 \uC2E4\uD5D8\uC744
      \uD558\uACE0 \uC788\uB098~?"
    leftSprite: {fileID: 652121894626912164, guid: 44b1bb5ad7b7e71489e18634a12d4487, type: 3}
    rightSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uB77C\uBE44\uB2C8\uC544"
    text: "\uC544\u2026.. \uC544\uB9C8 \u2018\uAC10\uC815\uC744 \uC0C9\uC73C\uB85C
      \uB098\uD0C0\uB0B4\uB294 \uB3C4\uB9C8\uBC40\u2019\uC744 \uB9CC\uB4DC\uB294
      \uC2E4\uD5D8\uC744 \uD558\uACE0 \uACC4\uC2E4\uAC70\uC5D0\uC694.."
    leftSprite: {fileID: 652121894626912164, guid: 44b1bb5ad7b7e71489e18634a12d4487, type: 3}
    rightSprite: {fileID: -4798111988831281657, guid: 5875437039abab04486fba29f3728f4c, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uB77C\uBE44\uB2C8\uC544"
    text: "\uCD5C\uADFC \uCE74\uBA5C\uB808\uC628\uC5D0\uC11C \uC601\uAC10\uC744 \uBC1B\uC558\uB2E4\uBA74\uC11C,
      \uAC10\uC815\uC744 \uC0C9\uC73C\uB85C \uB4DC\uB7EC\uB0B4\uB294 \uB3C4\uB9C8\uBC40\uC740
      \uC815\uB9D0 \uAD49\uC7A5\uD560 \uAC70\uB77C\uACE0\u2026  \\n\uACB0\uAD6D \uC2E4\uD5D8\uC2E4\uC744
      \uB6F0\uCCD0\uB098\uAC00 \uB3C4\uB9C8\uBC40\uC744 \uC9C1\uC811 \uAD6C\uD574\uC624\uC168\uAC70\uB4E0\uC694\u2026"
    leftSprite: {fileID: 652121894626912164, guid: 44b1bb5ad7b7e71489e18634a12d4487, type: 3}
    rightSprite: {fileID: -4798111988831281657, guid: 5875437039abab04486fba29f3728f4c, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uC774\uB9AC\uC5D8"
    text: "\uD638\uC624\u2026 \uADF8\uAC70 \uCC38 \uD765\uBBF8\uB85C\uC6B4\uB370?"
    leftSprite: {fileID: 652121894626912164, guid: 44b1bb5ad7b7e71489e18634a12d4487, type: 3}
    rightSprite: {fileID: -4798111988831281657, guid: 5875437039abab04486fba29f3728f4c, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uB098\uC774\uC544"
    text: "\u2026\uC774\uC81C"
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: 1113943883041212095, guid: 2c8fc658780b80f49a2c59da4d623714, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uC544\uC774\uB9B0"
    text: "\uC751?"
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: 1113943883041212095, guid: 2c8fc658780b80f49a2c59da4d623714, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uB098\uC774\uC544"
    text: "\uC774\uC81C \uADF8\uB9CC. \uD68C\uC758 \uC2DC\uC791\uD574 \uC918."
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: 1113943883041212095, guid: 2c8fc658780b80f49a2c59da4d623714, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uC544\uC774\uB9B0"
    text: "\uC544\uD558\uD558\u2026 \uBBF8\uC548. \uC61B\uB0A0 \uC0DD\uAC01\uB098\uB2C8\uAE4C
      \uAD1C\uD788 \uC815\uC774 \uB4E4\uC5B4\uC11C \uB9D0\uC774\uC9C0.  \\n\uADF8\uB798\uB3C4
      \uC774\uC81C \uC9C4\uC9DC \uC2DC\uC791\uD560\uAC8C!"
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: 1113943883041212095, guid: 2c8fc658780b80f49a2c59da4d623714, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uBCA0\uB974\uC81C\uC778"
    text: "( \uC544\uAE4C \uB0B4\uAC00 \uD55C \uB9D0\uC740 \uB4E3\uC9C0\uB3C4 \uC54A\uC558\uAD70.
      )"
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: 5446078680231761675, guid: b1ec169d5f450e24a910eacadf1ec4f9, type: 3}
    eventCommand: 
  - speakerType: 0
    speakerName: 
    text: "\uC544\uC774\uB9B0\uC740 \uB8E8\uBBF8\uB098\uAC00 \uACAA\uC5C8\uB358 \uC77C\uACFC
      \uBE44\uC2B7\uD55C \uBBFC\uC6D0\uB4E4\uC744 \uC8FC\uC81C\uB85C  \\n\uB9C8\uB140\uD68C
      \uC77C\uC6D0\uB4E4\uC5D0\uAC8C \uC0C1\uD669\uC758 \uC2EC\uAC01\uC131\uC744
      \uC54C\uB9AC\uBA70 \uD68C\uC758\uB97C \uC2DC\uC791\uD55C\uB2E4."
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: 5446078680231761675, guid: b1ec169d5f450e24a910eacadf1ec4f9, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uC544\uC774\uB9B0"
    text: "\u2026.\uC774\uAC74 \uBB34\uC2DC\uD560 \uC218 \uC5C6\uC5B4."
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: 5446078680231761675, guid: b1ec169d5f450e24a910eacadf1ec4f9, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uC544\uC774\uB9B0"
    text: "\uC6B0\uB9AC\uAC00 \uC9C1\uC811 \uB098\uC11C\uC11C \uC870\uC0AC\uD558\uC9C0
      \uC54A\uC73C\uBA74, \uB354 \uD070 \uC7AC\uC559\uC774 \uC0DD\uAE38 \uC218 \uC788\uC5B4."
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: 5446078680231761675, guid: b1ec169d5f450e24a910eacadf1ec4f9, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uBCA0\uB974\uC81C\uC778"
    text: "\uADF8 \uC774\uC0C1\uD55C \uC0DD\uBA85\uCCB4\uB97C \uC870\uC0AC\uD558\uB294
      \uAC83\uAE4C\uC9C4 \uC88B\uC544.  \\n\uC6B0\uB9AC\uB3C4 \uD53C\uD574\uB97C
      \uC785\uC744 \uC218 \uC788\uC73C\uB2C8."
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: 5446078680231761675, guid: b1ec169d5f450e24a910eacadf1ec4f9, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uBCA0\uB974\uC81C\uC778"
    text: "\uD558\uC9C0\uB9CC \uC778\uAC04\uB4E4\uACFC \u2018\uC6B0\uB9AC \uB9C8\uB140\uB4E4
      \uC0AC\uC774\uC758 \uAD00\uACC4\u2019 \uC5D0 \uB300\uD574\uC11C\u2026  \\n\uC78A\uC5C8\uB098
      \uBCF4\uAD70, \uC544\uC774\uB9B0."
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: 5446078680231761675, guid: b1ec169d5f450e24a910eacadf1ec4f9, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uBCA0\uB974\uC81C\uC778"
    text: "\uC6B0\uB9B0 \uC778\uAC04\uB4E4\uC774 \uB098\uD0C0\uB098\uAE30 \uD6E8\uC52C
      \uC804\uBD80\uD130, \uBCC4\uC758 \uC232 \uC544\uB798\uC5D0\uC11C \uC0B4\uC544\uC654\uC5B4. 
      \\n\uADF8\uB4E4\uC774 \uB3CC\uACFC \uBD88\uC744 \uBC30\uC6B0\uB358 \uC2DC\uC808\uC5D0\uB3C4,
      \uC6B0\uB9B0 \uB9C8\uB825\uC744 \uB2E4\uB8E8\uBA70 \uC774 \uB545\uC758 \uADE0\uD615\uC744
      \uC9C0\uCF1C\uC654\uC9C0."
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: 5446078680231761675, guid: b1ec169d5f450e24a910eacadf1ec4f9, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uBCA0\uB974\uC81C\uC778"
    text: "\uD558\uC9C0\uB9CC \uADF8\uB4E4\uC740 \uC810\uCC28 \uC790\uC2E0\uB4E4\uC758
      \uBC29\uC2DD\uC774 \u2018\uC9C4\uBCF4\u2019\uB77C\uACE0 \uBBFF\uAE30 \uC2DC\uC791\uD588\uC5B4. 
      \\n\uB9C8\uB825\uC744 \uB450\uB824\uC6CC\uD558\uACE0, \uC774\uD574\uD558\uB824
      \uD558\uC9C0 \uC54A\uC558\uC9C0."
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: 5446078680231761675, guid: b1ec169d5f450e24a910eacadf1ec4f9, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uBCA0\uB974\uC81C\uC778"
    text: "\uADF8\uB7FC\uC5D0\uB3C4 \uC6B0\uB9B0, \uC6B0\uB9AC \uBC29\uC2DD\uB300\uB85C
      \uC870\uC6A9\uD788 \uC0B4\uC544\uAC00\uB824 \uD588\uC5B4."
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: 5446078680231761675, guid: b1ec169d5f450e24a910eacadf1ec4f9, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uBCA0\uB974\uC81C\uC778"
    text: "\uC778\uAC04\uB4E4\uC740 \uC810\uC810 \uC6B0\uB9AC\uB97C \u2018\uAD34\uBB3C\u2019\uC774\uB77C
      \uCE6D\uD558\uBA70 \uBC30\uCC99\uD558\uAE30 \uC2DC\uC791\uD588\uC5B4."
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: 5446078680231761675, guid: b1ec169d5f450e24a910eacadf1ec4f9, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uBCA0\uB974\uC81C\uC778"
    text: "\uD558! \uADF8\uB7F0\uB370, \uC5B4\uCC98\uAD6C\uB2C8 \uC5C6\uAC8C\uB3C4
      \uADF8\uB4E4\uC740 \uC628\uAC16 \uC704\uC120\uC744 \uB5A8\uBA70 \uC778\uAC04\uACFC
      \uB9C8\uB140\uC640\uC758 \uAD00\uACC4\uB97C \uB2E8\uC808\uC2DC\uD0A4\uB824
      \uC870\uC57D\uC744 \uC81C\uC548\uD588\uC9C0."
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: 5446078680231761675, guid: b1ec169d5f450e24a910eacadf1ec4f9, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uBCA0\uB974\uC81C\uC778"
    text: "\uCC98\uC74C \uADF8 \uC870\uC57D\uC744 \uC81C\uC548 \uBC1B\uC558\uC744
      \uB550, \uD654\uAC00 \uB05D\uAE4C\uC9C0 \uCE58\uBC00\uC5B4 \uC62C\uB790\uC9C0."
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: 5446078680231761675, guid: b1ec169d5f450e24a910eacadf1ec4f9, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uBCA0\uB974\uC81C\uC778"
    text: "\uD558\uC9C0\uB9CC \uC591\uCABD \uBAA8\uB450 \uC11C\uB85C\uB97C \uC8FD\uC774\uB824
      \uB4E4\uC790, \uC6B0\uB9AC\uB3C4 \uACB0\uAD6D \uACE0\uC2EC \uB05D\uC5D0 \uBC1B\uC544\uB4E4\uC77C
      \uC218\uBC16\uC5D0 \uC5C6\uC5C8\uC5B4."
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: 5446078680231761675, guid: b1ec169d5f450e24a910eacadf1ec4f9, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uBCA0\uB974\uC81C\uC778"
    text: "\uADF8\uB9AC\uACE0 \uADF8 \uC870\uC57D\uC740 \uC624\uB298\uB0A0\uC5D0\uB3C4
      \uC720\uD6A8\uD558\uC9C0."
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: 5446078680231761675, guid: b1ec169d5f450e24a910eacadf1ec4f9, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uBCA0\uB974\uC81C\uC778"
    text: "\uB355\uBD84\uC5D0 \uC57C\uB9CC\uC801\uC774\uACE0 \uCD94\uC545\uD55C \uC778\uAC04\uB4E4\uACFC
      \uAC70\uB9AC\uAC00 \uBA40\uC5B4\uC84C\uC73C\uB2C8.  \\n\uCC38 \uB2E4\uD589\uC774\uC9C0."
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: 5446078680231761675, guid: b1ec169d5f450e24a910eacadf1ec4f9, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uC544\uC774\uB9B0"
    text: "\u2026\uADF8\uB798, \uB2F9\uC5F0\uD788 \uAE30\uC5B5\uD558\uACE0 \uC788\uC5B4."
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: 5446078680231761675, guid: b1ec169d5f450e24a910eacadf1ec4f9, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uC544\uC774\uB9B0"
    text: "\uD558\uC9C0\uB9CC \uB9C8\uB140\uB4E0 \uC778\uAC04\uC774\uB4E0, \uC9C0\uAE08\uC740
      \uADF8 \uACBD\uACC4\uC870\uCC28 \uC704\uD611\uBC1B\uACE0 \uC788\uB294 \uC0C1\uD669\uC774\uC57C."
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: 5446078680231761675, guid: b1ec169d5f450e24a910eacadf1ec4f9, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uC544\uC774\uB9B0"
    text: "\uAC8C\uB2E4\uAC00 \uADF8 \uC77C\uC740 \uC774\uBBF8 \uC624\uB798 \uC804
      \uC77C\uC774\uC57C\u2026"
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: 5446078680231761675, guid: b1ec169d5f450e24a910eacadf1ec4f9, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uB77C\uBE44\uB2C8\uC544"
    text: "\u2026\uADF8 \uC0DD\uBA85\uCCB4\uAC00 \uB9C8\uB825\uC744 \uD761\uC218\uD55C\uB2E4\uBA74,
      \uC6B0\uB9AC \uCABD\uB3C4\u2026 \uC548\uC804\uD558\uC9C0 \uC54A\uC744 \uAC70\uC608\uC694."
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: -4798111988831281657, guid: 5875437039abab04486fba29f3728f4c, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uB77C\uBE44\uB2C8\uC544"
    text: "\uB9C8\uB140\uB4E4\uC870\uCC28 \uB178\uB9B0\uB2E4\uBA74\u2026 \uC778\uAC04\uB4E4\uACFC\uC758
      \uAC08\uB4F1\uC740 \uB354 \uACA9\uD574\uC9C8\uC9C0\uB3C4 \uBAB0\uB77C\uC694\u2026"
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: -4798111988831281657, guid: 5875437039abab04486fba29f3728f4c, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB098\uC774\uC544"
    text: "\u2026\uC774\uAC74..\uC778\uAC04\uB4E4 \uD3B8\uC744 \uB4E4\uC790\uB294
      \uC774\uC57C\uAE30\uAC00 \uC544\uB2C8\uC57C, \uBCA0\uB974\uC81C\uC778..\u2026 
      \\n\uACB0\uAD6D \uBAA8\uB4E0 \uAC74 \uC6B0\uB9AC\uB97C \uC704\uD55C \uC77C\uC774\uC57C\u2026"
    leftSprite: {fileID: 1113943883041212095, guid: 2c8fc658780b80f49a2c59da4d623714, type: 3}
    rightSprite: {fileID: -4798111988831281657, guid: 5875437039abab04486fba29f3728f4c, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uBCA0\uB974\uC81C\uC778"
    text: "\u2026\uD558. \uADF8\uB7F0 \uB9D0\uB85C \uBAA8\uB4E0 \uAC78 \uB36E\uC73C\uB824
      \uD558\uC9C0 \uB9C8."
    leftSprite: {fileID: 1113943883041212095, guid: 2c8fc658780b80f49a2c59da4d623714, type: 3}
    rightSprite: {fileID: 5446078680231761675, guid: b1ec169d5f450e24a910eacadf1ec4f9, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uBCA0\uB974\uC81C\uC778"
    text: "\uC5B4\uC124\uD504\uAC8C \uAC1C\uC785\uD588\uB2E4\uAC04, \uC870\uC57D\uC740
      \uBB3C\uB860, \uC6B0\uB9AC \uC815\uCCB4\uAE4C\uC9C0 \uC704\uD0DC\uB85C\uC6CC\uC9C8
      \uC218\uB3C4 \uC788\uC5B4."
    leftSprite: {fileID: 1113943883041212095, guid: 2c8fc658780b80f49a2c59da4d623714, type: 3}
    rightSprite: {fileID: 5446078680231761675, guid: b1ec169d5f450e24a910eacadf1ec4f9, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uC544\uC774\uB9B0"
    text: "\uADF8\uB7EC\uB2C8\uAE4C \uC6B0\uB9AC\uAC00 \u2018\uC870\uC2EC\uC2A4\uB7FD\uAC8C\u2019
      \uC6C0\uC9C1\uC774\uC790\uB294 \uAC70\uC57C."
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: 5446078680231761675, guid: b1ec169d5f450e24a910eacadf1ec4f9, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uC544\uC774\uB9B0"
    text: "\uBD84\uC5F4\uC774 \uC544\uB2C8\uB77C \uD611\uB825\uC774 \uD544\uC694\uD560
      \uB54C\uC57C, \uBCA0\uB974\uC81C\uC778."
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: 5446078680231761675, guid: b1ec169d5f450e24a910eacadf1ec4f9, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uCE74\uB974\uC138\uC774\uB77C"
    text: "\uB098\uB294 \uBCA0\uB974\uC81C\uC778\uC758 \uB9D0\uC5D0 \uB3D9\uC758\uD574,
      \uC544\uC774\uB9B0."
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: -20122045393276472, guid: cfb15810cd3f2824f85eaab152e97c2c, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uCE74\uB974\uC138\uC774\uB77C"
    text: "\uADF8\uB4E4\uC740 \uC808\uB300 \uBBFF\uC744 \uC218 \uC5C6\uC5B4."
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: -20122045393276472, guid: cfb15810cd3f2824f85eaab152e97c2c, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uCE74\uB974\uC138\uC774\uB77C"
    text: "\uC6B0\uB9AC\uAC00 \uAD1C\uD788 \uC774\uC0C1\uD55C \uC6C0\uC9C1\uC784\uC744
      \uBCF4\uC600\uB2E4\uAC04 \uCC45\uC784\uC744 \uBB3B\uAC8C \uB418\uACA0\uC9C0."
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: -20122045393276472, guid: cfb15810cd3f2824f85eaab152e97c2c, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uCE74\uB974\uC138\uC774\uB77C"
    text: "\uAC8C\uB2E4\uAC00 \uADF8 \u2018\uC0DD\uBA85\uCCB4\u2019\uB294 \uB108\uC758
      \uC81C\uC790\uC778 \u2018\uB8E8\uBBF8\uB098\u2019\uAC00 \uD574\uCE58\uC6B8
      \uC218 \uC788\uC744 \uC815\uB3C4\uB85C \uBBF8\uC57D\uD55C \uC874\uC7AC\uC778
      \uAC83 \uAC19\uAD70."
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: -20122045393276472, guid: cfb15810cd3f2824f85eaab152e97c2c, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uCE74\uB974\uC138\uC774\uB77C"
    text: "\uC9C0\uAE08\uAE4C\uC9C0\uC758 \uC778\uBA85\uD53C\uD574\uB294 \uC5C6\uC9C0
      \uC54A\uC558\uC9C0 \uC54A\uB098."
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: -20122045393276472, guid: cfb15810cd3f2824f85eaab152e97c2c, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uCE74\uB974\uC138\uC774\uB77C"
    text: "\uADF8\uB807\uB2E4\uBA74, \uAD73\uC774 \uB098\uC124 \uD544\uC694\uB294
      \uC5C6\uC744 \uAC83 \uAC19\uB124.  \\n\uBD84\uBA85 \uB0B4 \uBC1C\uB05D\uC5D0
      \uBBF8\uCE58\uC9C0 \uBABB \uD560 \uC218\uC900\uC77C\uD14C\uB2C8."
    leftSprite: {fileID: -1265705340174883840, guid: c619c1651814be14ab9adfe358ee413e, type: 3}
    rightSprite: {fileID: -20122045393276472, guid: cfb15810cd3f2824f85eaab152e97c2c, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uCE74\uB974\uC138\uC774\uB77C"
    text: "\uC815\uB9D0 \uADF8 \uAC83\uC774 \uC704\uD611\uC774 \uB418\uB294 \uB0A0\uC774
