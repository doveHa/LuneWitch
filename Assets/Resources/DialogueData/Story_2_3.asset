  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uC774\uC0C1\uD558\uB124\u2026 \uC5EC\uAE30\uAE4C\uC9C0 \uC624\uBA74\uC11C
      \uC778\uAC04\uC740 \uD55C \uBA85\uB3C4 \uBABB \uBCF8 \uAC83 \uAC19\uC544."
