    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uADF8\uB807\uB2E4\uBA74\u2026 \uC65C \uC601\uC8FC\uB2D8\uAED8\uC120 \uADF8
      \uC218\uC0C1\uD55C \uC0DD\uBA85\uCCB4\uC640 \uB611\uAC19\uC740 \uB9C8\uB825\uC758
      \uAE30\uC6B4\uC744 \uB0B4\uBFDC\uACE0 \uACC4\uC2E0 \uAC70\uC8E0?"
