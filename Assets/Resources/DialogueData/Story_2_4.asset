    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "( \uAC8C\uB2E4\uAC00,\_ \uC601\uC8FC\uB2D8\uC5D0\uAC8C\uC11C \uC218\uC0C1\uD55C
