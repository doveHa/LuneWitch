  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6d9aab5c9c9d22b43bf5c4fdd35c67ef, type: 3}
  m_Name: Story_2_4
  m_EditorClassIdentifier: 
  introTitle: 
  introDescription: "\uC601\uC8FC\uC758 \uC800\uD0DD"
  backgroundSprite: {fileID: 994415258, guid: fc1288ec68de55d4cbd14a4ac7b952b0, type: 3}
  isIllustrationMode: 0
  illustrationSprite: {fileID: 0}
  tsvFile: {fileID: 4900000, guid: 07f8a531b960a2b40b2c764a3636a409, type: 3}
  lines:
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "(\u2026\uC800\uD0DD \uC548\uC5D0\uC11C\uB3C4 \uC774\uC0C1\uD55C \uAE30\uC6B4\uC774
      \uC0AC\uB77C\uC9C0\uC9C0 \uC54A\uC544. \uC774 \uC704\uD654\uAC10\uC740\u2026
      \uB3C4\uB300\uCCB4 \uBB50\uC9C0?)"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 0}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC54C\uBCA0\uB974\uD2B8 \uBCA8\uBAA8\uB974"
    text: "\uC624\uC168\uAD70\uC694. \uBCA0\uC2A4\uD398\uB77C \uB9C8\uC744\uC5D0\uC11C
      \uC624\uC2E0 \uC874\uADC0\uD55C \uB9C8\uB140\uB2D8."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC54C\uBCA0\uB974\uD2B8 \uBCA8\uBAA8\uB974"
    text: "\uC18C\uBB38\uC73C\uB85C\uB9CC \uB4E3\uB358 \uB9C8\uB140\uB2D8\uC744 \uC2E4\uC81C\uB85C\uB294
      \uCC98\uC74C \uBD59\uB294\uAD70\uC694."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC54C\uBCA0\uB974\uD2B8 \uBCA8\uBAA8\uB974"
    text: "\uB9C8\uB140\uB2D8\uAED8\uC11C \uC124\uB9C8\uBA3C\uC800 \uC81C\uAC8C \uC624\uC2E4
      \uC904\uC740 \uAFC8\uC5D0\uB3C4 \uBAB0\uB790\uC2B5\uB2C8\uB2E4."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC54C\uBCA0\uB974\uD2B8 \uBCA8\uBAA8\uB974"
    text: "\uAC89\uBAA8\uC2B5\uC744 \uBCF4\uC544\uD558\uB2C8 \uC0AC\uC808\uC774 \uC544\uB2CC
      \uB4EF \uD558\uAD70\uC694.."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC54C\uBCA0\uB974\uD2B8 \uBCA8\uBAA8\uB974"
    text: "\uC624\uC2DC\uB294 \uAE38\uC740 \uBD88\uD3B8\uD558\uC9C0 \uC54A\uC73C\uC168\uC2B5\uB2C8\uAE4C?"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "( \uC774 \uC0AC\uB78C\uC774 \uBCA8\uBAA8\uB9AC\uC544\uC758 \uC601\uC8FC\uB2D8\u2026
      \uC0C1\uC0C1\uBCF4\uB2E4 \uD6E8\uC52C \uC704\uC555\uC801\uC774\uC57C. )"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "( \uBD84\uC704\uAE30\uBD80\uD130\uAC00 \uC608\uC0AC\uB86D\uC9C0 \uC54A\uB124.
      \uC27D\uC9C0 \uC54A\uACA0\uC5B4. )"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uC774\uB7F0 \uAC11\uC791\uC2A4\uB7EC\uC6B4 \uB9CC\uB0A8\uC744 \uD5C8\uB77D\uD574
      \uC8FC\uC154\uC11C \uAC10\uC0AC\uB4DC\uB9BD\uB2C8\uB2E4."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uC18C\uBB38\uB300\uB85C \uD61C\uC548\uC774 \uAE4A\uC73C\uC2E0 \uC601\uC8FC\uB2D8\uC758
      \uB9D0\uC500\uB300\uB85C, \uC800\uB294 \uC815\uC2DD \uC0AC\uC808\uC774 \uC544\uB2D9\uB2C8\uB2E4."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uC624\uB294 \uAE38\uC740 \uBD88\uD3B8\uD568\uC774 \uC5C6\uC5C8\uC2B5\uB2C8\uB2E4\u2026\uB108\uBB34
      \uC870\uC6A9\uD574\uC11C \uC774\uC0C1\uD560 \uC815\uB3C4\uB85C\uC694."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC54C\uBCA0\uB974\uD2B8 \uBCA8\uBAA8\uB974"
    text: "\uD638\uC624.."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC54C\uBCA0\uB974\uD2B8 \uBCA8\uBAA8\uB974"
    text: "\uBCA8\uBAA8\uB9AC\uC548\uC740 \uC6D0\uB798\uBD80\uD130 \uC870\uC6A9\uD558\uACE0
      \uC810\uC796\uC740 \uACF3\uC785\uB2C8\uB2E4."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC54C\uBCA0\uB974\uD2B8 \uBCA8\uBAA8\uB974"
    text: "\uC0AC\uB78C\uB4E4\uC774 \uAC11\uC790\uAE30 \uC0AC\uB77C\uC9C4\uB2E4\uAC70\uB098,
      \uC774\uC0C1\uD55C \uAE30\uC6B4\uC774 \uAC10\uB3C4\uB294 \uC77C \uB530\uC704\uB294\u2026"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC54C\uBCA0\uB974\uD2B8 \uBCA8\uBAA8\uB974"
    text: "\uC194\uC9C1\uD788 \uB9D0\uC500\uB4DC\uB824, \uC81C \uC601\uC9C0\uC5D0\uC11C\uB294
      \uC788\uC744 \uC218 \uC5C6\uB294 \uC77C\uC774\uC9C0\uC694."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC54C\uBCA0\uB974\uD2B8 \uBCA8\uBAA8\uB974"
    text: "\uD639\uC2DC \uC9C0\uB098\uCE5C \uAC71\uC815\uC5D0 \uB9C8\uC74C\uC774
      \uC5B4\uC9C0\uB7EC\uC6B0\uC2E0 \uAC74 \uC544\uB2D0\uAE4C\uC694?"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC54C\uBCA0\uB974\uD2B8 \uBCA8\uBAA8\uB974"
    text: "\uC9C0\uAE08 \uBCF4\uC774\uB294 \uC870\uC6A9\uD568\uC740 \uADF8\uC800
      \uD3C9\uD654\uB85C\uC6B4 \uC77C\uC0C1\uC77C \uBFD0\uC785\uB2C8\uB2E4."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "( \uC218\uC0C1\uD574.. \uBC88\uD654\uAC00\uC5D0 \uC778\uAC04\uC774 \uD55C
      \uBA85\uB3C4 \uBCF4\uC774\uC9C0 \uC54A\uC558\uB294\uB370.. )"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "( \uADF8\uB7F0\uB370\uB3C4 \uC601\uC8FC\uB2D8\uC740 \uADF8 \uC0AC\uC2E4\uC744
      \uB108\uBB34 \uD0DC\uC5F0\uD558\uAC8C \uB118\uAE30\uACE0 \uC788\uC5B4\u2026
      \\n\uBB34\uC5B8\uAC00\uB97C \uAC10\uCD94\uACE0 \uC788\uB2E4\uB294 \uB290\uB08C\uC774
      \uC810\uC810 \uAC15\uD574\uC9C0\uACE0 \uC788\uC5B4. )"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uADF8\uB807\uAD70\uC694 \u2026\uC774\uACF3\uC774 \uC6D0\uB798 \uC870\uC6A9\uD55C
      \uACF3\uC774\uB77C\uBA74, \uC81C\uAC00 \uC9C0\uB098\uCE5C \uAC71\uC815\uC744
      \uD55C \uAC78\uC9C0\uB3C4 \uBAA8\uB974\uACA0\uB124\uC694."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uC0AC\uC2E4, \uCD5C\uADFC\uC5D0 \uBCA8\uBAA8\uB9AC\uC544 \uC8FC\uBBFC\uC73C\uB85C\uBD80\uD130
      \uC218\uC0C1\uD55C \uC0DD\uBA85\uCCB4\uB97C \uBC1C\uACAC\uD588\uC2B5\uB2C8\uB2E4."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\u2018\uBCA0\uC2A4\uD398\uB77C\u2019\uB294 \uC678\uBD80\uC640 \uCCA0\uC800\uD788
      \uB2E8\uC808\uB418\uC5B4 \uC788\uC73C\uBA70, \uBCA8\uBAA8\uB9AC\uC544 \uC778\uAC04\uB4E4\uC870\uCC28
      \uC27D\uAC8C \uCD9C\uC785\uD560 \uC218 \uC5C6\uB294 \uACF3\uC778\uAC74 \uC601\uC8FC\uB2D8\uB3C4
      \uC798 \uC54C\uACE0 \uACC4\uC2E4\uD14C\uC8E0."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uADF8 \uC0DD\uBA85\uCCB4\uB294 \uC0AC\uB78C\uC5D0\uAC8C \uAE30\uC0DD\uD574,
      \uC774\uC131\uC744 \uD750\uB9AC\uAC8C \uB9CC\uB4E4\uACE0 \uD1B5\uC81C\uB97C
      \uC783\uAC8C \uD558\uB294 \uD2B9\uC131\uC744 \uC9C0\uB2CC \uB4EF \uBCF4\uC600\uC8E0."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uADF8\uB7F0 \uC704\uD5D8\uD55C \uC874\uC7AC\uAC00 \uC6B0\uB9AC \uBCA0\uC2A4\uD398\uB77C
      \uB9C8\uC744\uC5D0 \uCE68\uBC94\uD558\uC600\uC73C\uB2C8\u2026"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uC774\uC5D0 \uB300\uD574 \uC544\uC2DC\uB294 \uBC14\uAC00 \uC788\uB294\uC9C0
      \uC5EC\uCB59\uACE0\uC790, \uC774\uB807\uAC8C \uC9C1\uC811 \uCC3E\uC544\uBD4C
      \uAC83\uC785\uB2C8\uB2E4."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC54C\uBCA0\uB974\uD2B8 \uBCA8\uBAA8\uB974"
    text: "\uC218\uC0C1\uD55C \uC0DD\uBA85\uCCB4\uB77C\uB2C8\u2026 \uCC98\uC74C \uB4E3\uB294
      \uC774\uC57C\uAE30\uAD70\uC694."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC54C\uBCA0\uB974\uD2B8 \uBCA8\uBAA8\uB974"
    text: "\uADF8\uB7F0 \uAD34\uC0C1\uD55C \uAC83\uC774 \uC81C \uC601\uC9C0\uC5D0\uC11C
      \uB098\uC654\uB2E4\uBA74 \uC81C\uAC00 \uAC00\uC7A5 \uBA3C\uC800 \uC54C\uC558\uC744
      \uAC81\uB2C8\uB2E4."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC54C\uBCA0\uB974\uD2B8 \uBCA8\uBAA8\uB974"
    text: "\uB9C8\uB140\uB2D8\uAED8\uC11C \uD639\uC2DC \uBB34\uC5B8\uAC00\uB97C \uC798\uBABB
      \uBCF4\uC2E0 \uAC74 \uC544\uB2CC\uC9C0\uC694?\\n\uC694\uC998 \uC0C1\uC0C1\uACFC
      \uD604\uC2E4\uC744 \uCC29\uAC01\uD558\uB294 \uC774\uB4E4\uC774 \uB9CE\uB354\uAD70\uC694."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uCC98\uC74C \uB4E3\uB294 \uC774\uC57C\uAE30\uB77C \uD558\uAE30\uC5D4,
      \uC601\uC8FC\uB2D8\uC758 \uBC18\uC751\uC774 \uC9C0\uB098\uCE58\uAC8C \uCE68\uCC29\uD574
      \uBCF4\uC774\uB124\uC694."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC54C\uBCA0\uB974\uD2B8 \uBCA8\uBAA8\uB974"
    text: "\uD638\uC624\u2026 \uC810\uC810 \uC774\uC57C\uAE30\uAC00 \uD765\uBBF8\uB85C\uC6CC\uC9C0\uB294\uAD70."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC54C\uBCA0\uB974\uD2B8 \uBCA8\uBAA8\uB974"
    text: "\uD558\uC9C0\uB9CC\u2026 \uB9D0\uC500 \uB4DC\uB838\uC796\uC2B5\uB2C8\uAE4C?
