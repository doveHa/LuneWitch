    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uAC8C\uB2E4\uAC00 \uC9C0\uAE08\uC740\u2026 \uC81C\uAC00 \uCC98\uC74C
