    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uD5C8\uC5B5\u2026 \uC544\uC2AC\uC544\uC2AC\uD588\uC5B4\u2026  \\n\uC804\uD22C\uAC00
      \uC870\uAE08\uB9CC \uB354 \uAE38\uC5B4\uC84C\uB2E4\uBA74, \uB9C8\uB825\uC774
      \uBC14\uB2E5\uB0AC\uC744 \uAC70\uC57C\u2026"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uC774, \uC774\uC81C \uC5B4\uB5A1\uD558\uC9C0\u2026  \\n\uC2A4\uC2B9\uB2D8\uAED8
      \uBB50\uB77C\uACE0 \uBCF4\uACE0\uD574\uC57C \uD558\uB294 \uAC70\uC57C\u2026?"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 0
    speakerName: 
    text: "\uC2E0\uC74C\uACFC \uD568\uAED8, \uB545\uC5D0 \uC4F0\uB7EC\uC838 \uC788\uB358
      \uC601\uC8FC\uAC00 \uCC9C\uCC9C\uD788 \uBAB8\uC744 \uC77C\uC73C\uD0A8\uB2E4."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC54C\uBCA0\uB974\uD2B8 \uBCA8\uBAA8\uB974(?)"
    text: "\u2026\uC73C\uC73D\u2026"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\u2026!"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 0
    speakerName: 
    text: "\uB8E8\uBBF8\uB098\uAC00 \uB2E4\uC2DC \uACBD\uACC4\uD0DC\uC138\uB97C \uCDE8\uD588\uB2E4."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC54C\uBCA0\uB974\uD2B8 \uBCA8\uBAA8\uB974(?)"
    text: "\u2026\uC11C\uCABD\uC5D0\uC11C \uC628 \uB9C8\uB140\uC5EC\u2026 \uACE0\uB9D9\uB124\u2026"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 0
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "( ?! \uC758\uC2DD\uC774 \uB3CC\uC544\uC654\uC5B4..!)"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 0
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "\uC9C0..\uC9C0\uAE08 \uB2F9\uC7A5 \uCE58\uB8CC\uD574 \uB4DC\uB9B4\uAC8C\uC694..!"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC54C\uBCA0\uB974\uD2B8 \uBCA8\uBAA8\uB974"
    text: "\u2026\uADF8\uB9CC\uD558\uAC8C\u2026"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC54C\uBCA0\uB974\uD2B8 \uBCA8\uBAA8\uB974"
    text: "\uADF8\uB300\uAC00 \uB0A0 \uCE58\uB8CC\uD558\uBA74\u2026 \uB0B4 \uC548\uC758
      \u2018\uB9C8\uACE0\uD0C0\uC2A4\u2019\uB3C4 \uD568\uAED8 \uD68C\uBCF5\uB420
      \uAC78\uC138\u2026"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 1
    speakerName: "\uB8E8\uBBF8\uB098"
    text: "(\u2026\uB9C8\uACE0\uD0C0\uC2A4\u2026)"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC54C\uBCA0\uB974\uD2B8 \uBCA8\uBAA8\uB974"
    text: "\uC2DC\uAC04\uC774 \uC5BC\uB9C8 \uC5C6\uC5B4. \uC9E7\uAC8C \uB9D0\uD558\uACA0\uB124\u2026"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC54C\uBCA0\uB974\uD2B8 \uBCA8\uBAA8\uB974"
    text: "\uC138\uC0C1\uC740 \uC774\uBBF8 \uC704\uD5D8\uC5D0 \uCC98\uD588\uB124."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC54C\uBCA0\uB974\uD2B8 \uBCA8\uBAA8\uB974"
    text: "\uACF3\uACF3\uC5D0\uC11C \u2018\uB9C8\uACE0\uD0C0\uC2A4\u2019\uB4E4\uC774
      \uBAA8\uC2B5\uC744 \uAC10\uCD94\uACE0 \uC788\uC9C0\uB9CC\u2026  \\n\uC810\uC810
      \uB4E4\uB053\uACE0 \uC788\uC5B4."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC54C\uBCA0\uB974\uD2B8 \uBCA8\uBAA8\uB974"
    text: "\uBA38\uC9C0\uC54A\uC544, \uC790\uB124\uB4E4\uC758 \uC601\uC9C0\uAE4C\uC9C0\uB3C4
      \uCE68\uBC94\uB2F9\uD558\uACA0\uC9C0\u2026"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC54C\uBCA0\uB974\uD2B8 \uBCA8\uBAA8\uB974"
    text: "\uADF8\uB4E4\uC740 \uC9C0\uAE08\uB3C4 \uAD50\uBB18\uD788 \uC0AC\uB78C\uB4E4\uC758
      \uB9C8\uB825\uC744 \uBE68\uC544\uB4E4\uC774\uBA70,  \\n\uC870\uC6A9\uD788 \uD798\uC744
      \uD0A4\uC6B0\uACE0 \uC788\uB124\u2026"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC54C\uBCA0\uB974\uD2B8 \uBCA8\uBAA8\uB974"
    text: "\uB098\uB294\u2026 \uB9C9\uC9C0 \uBABB\uD588\uC9C0\uB9CC\u2026\\n\uADF8\uB300\uB4E4\uC774\uB77C\uBA74
      \uAC00\uB2A5\uD560\uC9C0\uB3C4 \uBAA8\uB974\uC9C0."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC54C\uBCA0\uB974\uD2B8 \uBCA8\uBAA8\uB974"
    text: "\uC778\uAC04\uB4E4\uBCF4\uB2E4 \uB354 \uAC15\uD55C \uD798\uC744 \uC9C0\uB2CC
      \uADF8\uB300\uB4E4\uC774\u2026"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC54C\uBCA0\uB974\uD2B8 \uBCA8\uBAA8\uB974"
    text: "\uC6B0\uB9AC\uAC00 \uC790\uB124\uB4E4\uC5D0\uAC8C \uC2E0\uC138\uB97C \uC9C4
      \uAC83\uC774 \uD55C\uB450 \uBC88\uC774 \uC544\uB2C8\uC9C0\u2026\\n\uC774\uBC88\uC5D0\uB3C4\u2026
      \uADF8 \uC740\uD61C\uB97C \uBE4C\uB824 \uC8FC\uACA0\uB098..?"
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
  - speakerType: 2
    speakerName: "\uC54C\uBCA0\uB974\uD2B8 \uBCA8\uBAA8\uB974"
    text: "\uBCA8\uBAA8\uB9AC\uC548\uC758 \uC601\uC8FC\uB85C\uC11C\u2026 \uCC38\uC73C\uB85C
      \uBA74\uBAA9\uC774 \uC5C6\uB124."
    leftSprite: {fileID: 5352576004762474852, guid: dc6975b729361dc43bae75da403e04ca, type: 3}
    rightSprite: {fileID: 5233598951272404550, guid: 76769d4a49f06784cb307ca7bfd186d2, type: 3}
    eventCommand: 
